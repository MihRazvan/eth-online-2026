{
  "name": "feestrip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @feestrip/web dev",
    "build": "pnpm --filter @feestrip/web build",
    "test": "node --test packages/core/test/*.test.mjs packages/data/test/*.test.mjs scripts/chain/proof.test.mjs scripts/graph/*.test.mjs packages/listings/test/*.test.mjs",
    "test:contracts": "forge test",
    "test:browser": "pnpm --filter @feestrip/web test",
    "check:handoff": "node scripts/check-handoff.mjs",
    "test:mutation": "python3 contracts/scripts/check-denominator-mutation.py",
    "test:static": "python3 scripts/static/check.py",
    "generate:abis": "node scripts/generate-abis.mjs",
    "build:subgraph": "graph codegen packages/subgraph/subgraph.yaml --output-dir packages/subgraph/generated && graph build packages/subgraph/subgraph.yaml --output-dir packages/subgraph/build",
    "local:reset": "node scripts/chain/reset-and-seed.mjs --reset",
    "local:mature": "node scripts/chain/mature.mjs",
    "test:chain": "node scripts/chain/lifecycle.mjs",
    "test:fork": "forge script scripts/proof/VerifyPublic.s.sol --fork-url https://ethereum-sepolia-rpc.publicnode.com --fork-block-number 11682192 -vv",
    "test:browser:chain": "playwright test -c apps/web/playwright.chain.config.ts",
    "test:substreams": "packages/substreams/verify.sh",
    "dev:data": "node packages/data/src/server.mjs",
    "test:settlement": "node packages/settlement/test/run.mjs",
    "test:public-setup": "node --test scripts/public/*.test.mjs",
    "dev:recovery": "node packages/settlement/src/cli.mjs --serve",
    "local:retention-config": "node scripts/chain/retention-config.mjs",
    "build:vercel": "pnpm --filter @feestrip/web exec tsc --noEmit && node scripts/deploy/build-vercel.mjs",
    "test:operations": "node --test packages/operations/test/*.test.mjs scripts/deploy/verify-operations.test.mjs scripts/deploy/verify-proof-restore.test.mjs scripts/deploy/monitor-project-cost.test.mjs",
    "test:keeper": "node --test packages/keeper/test/*.test.mjs",
    "dev:operations": "node packages/operations/src/cli.mjs",
    "dev:listings": "node packages/listings/src/local.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@bufbuild/protobuf": "1.10.1",
    "@connectrpc/connect": "1.7.0",
    "@connectrpc/connect-node": "1.7.0",
    "@substreams/core": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.2",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "railway": "3.11.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
